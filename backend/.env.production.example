# ==============================================================================
# MyHospital Backend — Production Environment Variables
# ==============================================================================
# Copy this file to backend/.env on the production server and fill in
# every value marked with <...>. Never commit the filled-in file.
#
# Generate secrets:
#   openssl rand -hex 32
# ==============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="MyHospital Backend"
VERSION=1.0.0

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=<generate-a-64-char-hex-string>

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mh_prod
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mh_prod

# Don't auto-create tables in production; use Alembic migrations instead.
CREATE_TABLES_ON_STARTUP=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=<https://your-frontend-domain.com>

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0

# ── Sessions (Redis) ─────────────────────────────────────────────────────────
SESSION_BACKEND=redis
SESSION_REDIS_HOST=redis
SESSION_SECURE_COOKIES=true
CSRF_ENABLED=true
TRUSTED_PROXY_HOPS=1

# ── Rate Limiting (Redis) ────────────────────────────────────────────────────
RATE_LIMITER_ENABLED=true
RATE_LIMITER_BACKEND=redis
RATE_LIMITER_REDIS_HOST=redis
RATE_LIMITER_FAIL_OPEN=true

# ── Taskiq (Redis) ───────────────────────────────────────────────────────────
TASKIQ_ENABLED=true
TASKIQ_BROKER_TYPE=redis
TASKIQ_REDIS_HOST=redis

# ── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_ENABLED=false

# ── API Docs ──────────────────────────────────────────────────────────────────
# Empty = disable /docs and /redoc in production.
OPENAPI_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Workers ───────────────────────────────────────────────────────────────────
# Number of uvicorn workers for the API container.
# Rule of thumb: 2 × CPU cores + 1
WORKERS=2

# ── AWS / Notifications (optional) ───────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SNS_FCM_PLATFORM_APPLICATION_ARN=
